@Aldis.Api_HostAddress = http://localhost:8001

### 1. IsoCategory - Get All
GET {{Aldis.Api_HostAddress}}/api/IsoCategory
Accept: application/json

### 2. IsoCategory - Create
POST {{Aldis.Api_HostAddress}}/api/IsoCategory
Content-Type: application/json

{
  "name": "Quality Management",
  "createdBy": "admin"
}

### 3. IsoStandard - Get All
GET {{Aldis.Api_HostAddress}}/api/IsoStandard
Accept: application/json

### 4. IsoStandard - Create
POST {{Aldis.Api_HostAddress}}/api/IsoStandard
Content-Type: application/json

{
  "code": "ISO 9001",
  "version": "2015",
  "title": "Quality Management Systems",
  "categoryId": 1,
  "effectiveDate": "2026-08-31",
  "createdBy": "admin"
}

### 5. Department - Get All
GET {{Aldis.Api_HostAddress}}/api/Department
Accept: application/json

